<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rpzh.dao.TaskManagementDao">
<insert id="addTask">
  INSERT INTO tb_task(
   <if test="taskDto.taskNum != null and taskDto.taskNum != ''">
  `task_num`,
   </if>
   <if test="taskDto.type != null and taskDto.type != ''">
  `type`,
   </if>
   <if test="taskDto.detail != null and taskDto.detail != ''">
    `task_detail`,
   </if>
  <if test="taskDto.principal != null and taskDto.principal != ''">
     `principal`,
   </if>
 <if test="taskDto.endTime != null and taskDto.endTime != ''">
      `end_time`,
   </if>
 <if test="taskDto.createdUser != null and taskDto.createdUser != ''">
     `created_user`,
   </if>
  <if test="taskDto.createdTime != null and taskDto.createdTime != ''">
       `create_time`,
   </if>
   task_address,
   site_route,
    push_way
  )
  VALUES
  	(
  <if test="taskDto.taskNum != null and taskDto.taskNum != ''">
  #{taskDto.taskNum},
   </if>
   <if test="taskDto.type != null and taskDto.type != ''">
  #{taskDto.type},
   </if>
   <if test="taskDto.detail != null and taskDto.detail != ''">
    #{taskDto.detail},
   </if>
  <if test="taskDto.principal != null and taskDto.principal != ''">
     #{taskDto.principal},
   </if>
 <if test="taskDto.endTime != null and taskDto.endTime != ''">
     #{taskDto.endTime},
   </if>
 <if test="taskDto.createdUser != null and taskDto.createdUser != ''">
    #{taskDto.createdUser},
   </if>
  <if test="taskDto.createdTime != null and taskDto.createdTime != ''">
     #{taskDto.createdTime},
   </if>
      #{taskDto.taskAddress},
      #{taskDto.taskSiteRoute},
      #{taskDto.pushWay}
  	)
  </insert>
<resultMap id="findTask" type="com.rpzh.vo.TaskVo">
   <id property="id" column="id"/>
   <result property="taskNum" column="task_num"/>
   <result property="taskAddress" column="task_address"/>
   <result property="type" column="type"/>
   <result property="createdTime" column="create_time"/>
   <result property="endTime" column="end_time"/>
   <result property="detail" column="task_detail"/>
   <result property="principal" column="principal"/>
   <result property="status" column="status"/>
   <result property="dealMethod" column="deal_method"/>
   <result property="finishTime" column="finish_time"/>
   <result property="createdUser" column="created_user"/>
   <result property="evaluate" column="evaluate"/>
   <result property="pushWay" column="push_way"/>
   <result property="dealResult" column="deal_result"/>
   <result property="pictureUrl" column="picture_url"/>
   <result property="pictureGroup" column="picture_group"/>
   <result property="pictureFilename" column="picture_filename"/>
</resultMap>
<select id="findTask" resultMap="findTask">
  SELECT id,task_num,type,task_detail,task_address,principal,end_time,create_time,status,picture_url,picture_group,picture_filename
  FROM tb_task
  <where>
  <if test="taskDto.taskNum != null and taskDto.taskNum != ''">
     AND task_num like concat('%', #{taskDto.taskNum}, '%')
  </if>
  <if test="taskDto.status != null and taskDto.status != ''">
     AND status = #{taskDto.status}
  </if>
  <if test="taskDto.type != null and taskDto.type != ''">
     AND type = #{taskDto.type}
  </if>
  <if test="taskDto.principal != null and taskDto.principal != ''">
     AND principal = #{taskDto.principal}
  </if>
  <if test="taskDto.endTime != null and taskDto.endTime != ''">
     AND end_time &lt;= #{taskDto.endTime}
  </if>
  <if test="taskDto.endStartTime != null and taskDto.endStartTime != ''">
     AND end_time &gt;= #{taskDto.endStartTime}
  </if>
  </where>
</select>
<update id="mqUpdateStatus">
  UPDATE tb_task
  SET
  status = '2'
  WHERE
	task_num = #{msg} and status = #{taskStatus}
</update>
<delete id="delTask">
 DELETE
 FROM tb_task
 WHERE id in
 <foreach collection="ids" item="id" open="(" separator="," close=")">
   #{id}
 </foreach>
</delete>
<select id="findTaskDetail" resultMap="findTask">
  SELECT id,task_num,type,task_detail,task_address,principal,end_time,create_time,status,
  deal_method,deal_result,picture_url,evaluate
  FROM tb_task
  where id = #{id}
</select>
<select id="findTaskByUser" resultMap="findTask">
 SELECT id,task_num,type,task_detail,task_address,principal,end_time,create_time,status,picture_url,picture_group,picture_filename
 FROM tb_task
  <where>
  <if test="taskDto.taskNum != null and taskDto.taskNum != ''">
     AND task_num like concat('%', #{taskDto.taskNum}, '%')
  </if>
  <if test="taskDto.status != null and taskDto.status != ''">
     AND status = #{taskDto.status}
  </if>
  <if test="taskDto.type != null and taskDto.type != ''">
     AND type = #{taskDto.type}
  </if>
  <if test="taskDto.principal != null and taskDto.principal != ''">
     AND principal = #{taskDto.principal}
  </if>
  <if test="taskDto.endTime != null and taskDto.endTime != ''">
     AND end_time &lt;= #{taskDto.endTime}
  </if>
  <if test="taskDto.endStartTime != null and taskDto.endStartTime != ''">
     AND end_time &gt;= #{taskDto.endStartTime}
  </if>
  </where>
</select>
<update id="taskDispose">
  UPDATE tb_task
   <set>
       <if test="taskDto.dealMethod != null and taskDto.dealMethod != ''">deal_method = #{taskDto.dealMethod},</if>
       <if test="taskDto.dealResult != null and taskDto.dealResult != ''">deal_result = #{taskDto.dealResult},</if>
       status = #{taskDto.status},
       finish_time = #{taskDto.finishTime}
   </set>
  WHERE id = #{taskDto.id}
</update>
<update id="taskEvaluate">
  UPDATE tb_task
   <set>
    <if test="taskDto.evaluate != null and taskDto.evaluate != ''">evaluate = #{taskDto.evaluate},</if>
    evaluate_user = #{taskDto.evaluateUser},
    evaluate_time = #{taskDto.evaluateTime}
   </set>
  WHERE id = #{taskDto.id}
</update>
</mapper>

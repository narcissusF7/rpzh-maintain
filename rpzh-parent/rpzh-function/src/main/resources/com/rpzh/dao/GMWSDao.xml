    <select id="findNodeData" resultType="com.rpzh.vo.NodeDataVo">
        SELECT
            t.nodeId,
            any(t.stackId) stackId,
            <if test="tableName=='tb_node_env_history'">
                any(t.humiture) humiture,
                any(t.temp) temp,
            </if>

            <if test="tableName!='tb_node_env_history'">
                any(t.${column}) ${column},
            </if>

            any(t.gatherSite) gatherSite,
            any(t.transferTime) transferTime
        from
            (
             select
                 node_id nodeId ,
                 stack_id stackId ,
                <if test="tableName=='tb_node_env_history'">
                    humiture humiture,
                    temp temp,
                </if>

                <if test="tableName!='tb_node_env_history'">
                    ${column} ${column},
                </if>
                 gather_site gatherSite ,
                 transfer_time transferTime
             from
                 ${tableName}
             order by
                 transfer_time
            ) t
        group by
            t.nodeId
    </select>
</mapper>
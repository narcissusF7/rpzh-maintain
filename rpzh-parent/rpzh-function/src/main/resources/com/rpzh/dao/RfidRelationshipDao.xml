<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rpzh.dao.RfidRelationshipDao">
    <insert id="addRfidRelationship">
        insert into tb_rfid_relationship (rfid,rfid_type,site_id)values(#{rfid},#{rfidType},#{siteId})
    </insert>
    <delete id="deleteRfidRelationship">
        delete from tb_rfid_relationship where site_id in
        <foreach collection="siteIds" item="siteId" open="(" separator="," close=")">
            #{siteId}
        </foreach>
        and rfid_type= #{rfidType}
    </delete>
    <select id="findRfidCount" resultType="java.lang.Integer">
        select count(*) from tb_rfid_relationship where rfid = #{rfid}
    </select>
</mapper>
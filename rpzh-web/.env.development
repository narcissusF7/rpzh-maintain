# ===== 请求地址 =====
# 开发环境统一走 vite 代理，浏览器侧不产生跨域
VITE_API_BASE=/api

# 代理目标：
#   网关（推荐）      http://localhost:8080
#   直连 system 服务  http://localhost:16883  ← 此时要把下面的 STRIP 改成 true
VITE_PROXY_TARGET=http://localhost:8080
VITE_PROXY_STRIP_PREFIX=false

# ===== 演示模式 =====
# 本机 tb_user 为空、OAuth 客户端未配置时真实登录必然失败，
# 打开此项可在登录页使用「本地点一次进入」，只写入本地假令牌，不请求后端。
# 仅开发环境有效，生产包会忽略。
VITE_ENABLE_DEMO_LOGIN=true

# 中台统一登录入口开关：true=登录页显示"中台账号登录"按钮（需后端 platform.sso.enabled=true 同步开启）
VITE_ENABLE_PLATFORM_SSO=false
